rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isAdmin() {
      return isVerifiedUser() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.email == "braian.kleber.camargo@gmail.com"
      );
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll([
          'uid', 'displayName', 'defaultAddress', 'phone',
          'loyaltyPoints', 'tier', 'role', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'uid', 'displayName', 'defaultAddress', 'phone',
          'loyaltyPoints', 'tier', 'role', 'createdAt', 'updatedAt'
        ]) &&
        data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 && data.uid.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.uid == request.auth.uid &&
        data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80 &&
        data.defaultAddress is string && data.defaultAddress.size() >= 3 && data.defaultAddress.size() <= 240 &&
        data.phone is string && data.phone.size() >= 3 && data.phone.size() <= 30 &&
        data.loyaltyPoints is number && data.loyaltyPoints >= 0 && data.loyaltyPoints <= 1000000 &&
        data.tier is string && data.tier.size() >= 4 && data.tier.size() <= 20 &&
        data.tier in ['Bronze', 'Prata', 'Ouro', 'Reserva Black'] &&
        data.role is string && data.role.size() >= 5 && data.role.size() <= 16 &&
        data.role in ['customer', 'partner'] &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidStorePlace(data) {
      return data.keys().hasAll([
          'id', 'ownerId', 'name', 'neighborhood', 'address',
          'lat', 'lng', 'rating', 'reviewCount', 'reviewCountFormatted',
          'prepMinutes', 'etaRangeLabel', 'deliveryLabel', 'specialty',
          'isOpen', 'spriteViewBox', 'visibility', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'ownerId', 'name', 'neighborhood', 'address',
          'lat', 'lng', 'rating', 'reviewCount', 'reviewCountFormatted',
          'prepMinutes', 'etaRangeLabel', 'deliveryLabel', 'specialty',
          'isOpen', 'spriteViewBox', 'visibility', 'createdAt', 'updatedAt'
        ]) &&
        data.id is string && data.id.size() >= 1 && data.id.size() <= 128 && data.id.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 && data.ownerId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.ownerId == request.auth.uid &&
        data.name is string && data.name.size() >= 2 && data.name.size() <= 80 &&
        data.neighborhood is string && data.neighborhood.size() >= 2 && data.neighborhood.size() <= 80 &&
        data.address is string && data.address.size() >= 5 && data.address.size() <= 240 &&
        data.lat is number && data.lat >= -90 && data.lat <= 90 &&
        data.lng is number && data.lng >= -180 && data.lng <= 180 &&
        data.rating is number && data.rating >= 1 && data.rating <= 5 &&
        data.reviewCount is number && data.reviewCount >= 0 && data.reviewCount <= 1000000 &&
        data.reviewCountFormatted is string && data.reviewCountFormatted.size() >= 1 && data.reviewCountFormatted.size() <= 20 &&
        data.prepMinutes is number && data.prepMinutes >= 1 && data.prepMinutes <= 180 &&
        data.etaRangeLabel is string && data.etaRangeLabel.size() >= 2 && data.etaRangeLabel.size() <= 30 &&
        data.deliveryLabel is string && data.deliveryLabel.size() >= 2 && data.deliveryLabel.size() <= 30 &&
        data.specialty is string && data.specialty.size() >= 2 && data.specialty.size() <= 200 &&
        data.isOpen is bool &&
        data.spriteViewBox is string && data.spriteViewBox.size() >= 3 && data.spriteViewBox.size() <= 40 &&
        data.visibility is string && data.visibility.size() == 6 && data.visibility == 'public' &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidProductCatalogItem(data) {
      return data.keys().hasAll([
          'id', 'ownerId', 'storeId', 'storeName', 'name',
          'category', 'tagLabel', 'description', 'origin', 'intensity',
          'rating', 'reviewsCountLabel', 'price', 'image', 'inStock',
          'visibility', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'ownerId', 'storeId', 'storeName', 'name',
          'category', 'tagLabel', 'description', 'origin', 'intensity',
          'rating', 'reviewsCountLabel', 'price', 'image', 'inStock',
          'visibility', 'createdAt', 'updatedAt'
        ]) &&
        data.id is string && data.id.size() >= 1 && data.id.size() <= 128 && data.id.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 && data.ownerId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.ownerId == request.auth.uid &&
        data.storeId is string && data.storeId.size() >= 1 && data.storeId.size() <= 128 && data.storeId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.storeName is string && data.storeName.size() >= 2 && data.storeName.size() <= 80 &&
        data.name is string && data.name.size() >= 2 && data.name.size() <= 90 &&
        data.category is string && data.category.size() >= 4 && data.category.size() <= 20 &&
        data.category in ['Cigarros', 'Tabaco', 'Charutos', 'Seda', 'Isqueiros', 'Vape'] &&
        data.tagLabel is string && data.tagLabel.size() >= 1 && data.tagLabel.size() <= 30 &&
        data.description is string && data.description.size() >= 3 && data.description.size() <= 200 &&
        data.origin is string && data.origin.size() >= 2 && data.origin.size() <= 40 &&
        data.intensity is string && data.intensity.size() >= 2 && data.intensity.size() <= 40 &&
        data.rating is number && data.rating >= 1 && data.rating <= 5 &&
        data.reviewsCountLabel is string && data.reviewsCountLabel.size() >= 1 && data.reviewsCountLabel.size() <= 30 &&
        data.price is number && data.price > 0 && data.price <= 50000 &&
        data.image is string && data.image.size() >= 5 && data.image.size() <= 300 &&
        data.inStock is bool &&
        data.visibility is string && data.visibility.size() == 6 && data.visibility == 'public' &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidOrder(data) {
      return data.keys().hasAll([
          'orderId', 'userId', 'customerName', 'storeId', 'storeName',
          'itemsSummary', 'totalAmount', 'deliveryFee', 'paymentMethod',
          'stripeTxId', 'deliveryAddress', 'status', 'loyaltyEarned',
          'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'orderId', 'userId', 'customerName', 'storeId', 'storeName',
          'itemsSummary', 'totalAmount', 'deliveryFee', 'paymentMethod',
          'stripeTxId', 'deliveryAddress', 'status', 'loyaltyEarned',
          'createdAt', 'updatedAt'
        ]) &&
        data.orderId is string && data.orderId.size() >= 1 && data.orderId.size() <= 128 && data.orderId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 && data.userId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.customerName is string && data.customerName.size() >= 1 && data.customerName.size() <= 80 &&
        data.storeId is string && data.storeId.size() >= 1 && data.storeId.size() <= 64 && data.storeId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.storeName is string && data.storeName.size() >= 1 && data.storeName.size() <= 80 &&
        data.itemsSummary is string && data.itemsSummary.size() >= 1 && data.itemsSummary.size() <= 500 &&
        data.totalAmount is number && data.totalAmount >= 1 && data.totalAmount <= 100000 &&
        data.deliveryFee is number && data.deliveryFee >= 0 && data.deliveryFee <= 500 &&
        data.paymentMethod is string && data.paymentMethod.size() >= 3 && data.paymentMethod.size() <= 32 &&
        data.paymentMethod in ['pix_entrega', 'dinheiro_entrega', 'cartao_credito_entrega', 'cartao_debito_entrega', 'stripe_card', 'pix', 'apple_pay'] &&
        data.stripeTxId is string && data.stripeTxId.size() >= 3 && data.stripeTxId.size() <= 120 &&
        data.deliveryAddress is string && data.deliveryAddress.size() >= 5 && data.deliveryAddress.size() <= 240 &&
        data.status is string && data.status.size() >= 7 && data.status.size() <= 20 &&
        data.status in ['confirmed', 'preparing', 'delivering', 'delivered', 'cancelled'] &&
        data.loyaltyEarned is number && data.loyaltyEarned >= 0 && data.loyaltyEarned <= 10000 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidReview(data) {
      return data.keys().hasAll([
          'reviewId', 'userId', 'authorName', 'storeId', 'storeName',
          'rating', 'comment', 'visibility', 'createdAt'
        ]) &&
        data.keys().hasOnly([
          'reviewId', 'userId', 'authorName', 'storeId', 'storeName',
          'rating', 'comment', 'visibility', 'createdAt'
        ]) &&
        data.reviewId is string && data.reviewId.size() >= 1 && data.reviewId.size() <= 128 && data.reviewId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 && data.userId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.userId == request.auth.uid &&
        data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 80 &&
        data.storeId is string && data.storeId.size() >= 1 && data.storeId.size() <= 64 && data.storeId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.storeName is string && data.storeName.size() >= 1 && data.storeName.size() <= 80 &&
        data.rating is number && data.rating >= 1 && data.rating <= 5 &&
        data.comment is string && data.comment.size() >= 3 && data.comment.size() <= 600 &&
        data.visibility is string && data.visibility.size() == 6 && data.visibility == 'public' &&
        data.createdAt is timestamp;
    }

    function isValidSupportMessage(data) {
      return data.keys().hasAll([
          'messageId', 'userId', 'senderName', 'senderRole', 'text', 'createdAt'
        ]) &&
        data.keys().hasOnly([
          'messageId', 'userId', 'senderName', 'senderRole', 'text', 'createdAt'
        ]) &&
        data.messageId is string && data.messageId.size() >= 1 && data.messageId.size() <= 128 && data.messageId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 && data.userId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.senderName is string && data.senderName.size() >= 1 && data.senderName.size() <= 80 &&
        data.senderRole is string && data.senderRole.size() >= 7 && data.senderRole.size() <= 16 &&
        data.senderRole in ['customer', 'support'] &&
        data.text is string && data.text.size() >= 1 && data.text.size() <= 500 &&
        data.createdAt is timestamp;
    }

    match /admins/{adminId} {
      allow get: if isSignedIn() && isValidId(adminId) && (request.auth.uid == adminId || isAdmin());
      allow list, create, update, delete: if false;
    }

    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow create: if isVerifiedUser() &&
        isValidId(userId) &&
        isOwner(userId) &&
        isValidUserProfile(incoming()) &&
        incoming().uid == userId &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isVerifiedUser() &&
        isValidId(userId) &&
        isValidUserProfile(incoming()) &&
        incoming().uid == existing().uid &&
        incoming().role == existing().role &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          isAdmin() ||
          (isOwner(userId) && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'defaultAddress', 'phone', 'loyaltyPoints', 'tier', 'updatedAt']))
        );
      allow delete: if false;
    }

    match /stores/{storeId} {
      allow get: if isValidId(storeId) && existing().visibility == 'public';
      allow list: if resource.data.visibility == 'public';
      allow create: if isVerifiedUser() &&
        isValidId(storeId) &&
        isValidStorePlace(incoming()) &&
        incoming().id == storeId &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isVerifiedUser() &&
        isValidId(storeId) &&
        isValidStorePlace(incoming()) &&
        incoming().id == existing().id &&
        incoming().ownerId == existing().ownerId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          isAdmin() ||
          (
            existing().ownerId == request.auth.uid &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'name', 'neighborhood', 'address', 'lat', 'lng',
              'prepMinutes', 'etaRangeLabel', 'deliveryLabel',
              'specialty', 'isOpen', 'updatedAt'
            ])
          )
        );
      allow delete: if isVerifiedUser() && isValidId(storeId) && (existing().ownerId == request.auth.uid || isAdmin());
    }

    match /products/{productId} {
      allow get: if isValidId(productId) && existing().visibility == 'public';
      allow list: if resource.data.visibility == 'public';
      allow create: if isVerifiedUser() &&
        isValidId(productId) &&
        isValidProductCatalogItem(incoming()) &&
        incoming().id == productId &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isVerifiedUser() &&
        isValidId(productId) &&
        isValidProductCatalogItem(incoming()) &&
        incoming().id == existing().id &&
        incoming().ownerId == existing().ownerId &&
        incoming().storeId == existing().storeId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          isAdmin() ||
          (
            existing().ownerId == request.auth.uid &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'name', 'category', 'tagLabel', 'description',
              'origin', 'intensity', 'price', 'image',
              'inStock', 'updatedAt'
            ])
          )
        );
      allow delete: if isVerifiedUser() && isValidId(productId) && (existing().ownerId == request.auth.uid || isAdmin());
    }

    match /orders/{orderId} {
      allow get: if isSignedIn() && isValidId(orderId) && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isVerifiedUser() &&
        isValidId(orderId) &&
        isValidOrder(incoming()) &&
        incoming().orderId == orderId &&
        incoming().userId == request.auth.uid &&
        incoming().status == 'confirmed' &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isVerifiedUser() &&
        isValidId(orderId) &&
        isValidOrder(incoming()) &&
        incoming().orderId == existing().orderId &&
        incoming().userId == existing().userId &&
        incoming().storeId == existing().storeId &&
        incoming().totalAmount == existing().totalAmount &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          isAdmin() ||
          (
            (
              existing().userId == request.auth.uid ||
              (
                exists(/databases/$(database)/documents/stores/$(existing().storeId)) &&
                get(/databases/$(database)/documents/stores/$(existing().storeId)).data.ownerId == request.auth.uid
              )
            ) &&
            !(existing().status in ['delivered', 'cancelled']) &&
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
          )
        );
      allow delete: if false;
    }

    match /reviews/{reviewId} {
      allow get: if isValidId(reviewId) && existing().visibility == 'public';
      allow list: if resource.data.visibility == 'public';
      allow create: if isVerifiedUser() &&
        isValidId(reviewId) &&
        isValidReview(incoming()) &&
        incoming().reviewId == reviewId &&
        incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if isVerifiedUser() && isValidId(reviewId) && (existing().userId == request.auth.uid || isAdmin());
    }

    match /supportMessages/{messageId} {
      allow get: if isSignedIn() && isValidId(messageId) && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isVerifiedUser() &&
        isValidId(messageId) &&
        isValidSupportMessage(incoming()) &&
        incoming().messageId == messageId &&
        (incoming().userId == request.auth.uid || isAdmin()) &&
        incoming().createdAt == request.time;
      allow update, delete: if false;
    }
  }
}
